# /my-zone notetaker — Appwrite Cloud credentials
# Copy this file to .env and fill in your project values.
# For GitHub Pages deploy, add these as repo Actions secrets
# (Settings → Secrets and variables → Actions) — deploy.yml reads them.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_TOPICS_COLLECTION_ID=
VITE_APPWRITE_NOTES_COLLECTION_ID=
VITE_APPWRITE_IMAGES_BUCKET_ID=
VITE_APPWRITE_POSTS_COLLECTION_ID=
